# =============================================================================
# ndre.gstore - contoh konfigurasi. SALIN menjadi .env.local (tidak masuk repo).
# Blueprint §13.1 / §18.1: JANGAN menaruh secret di repository, log, atau client bundle.
# Nilai di bawah adalah nama variabel + default non-rahasia, BUKAN kredensial.
# =============================================================================

# --- Aplikasi ---
NEXT_PUBLIC_APP_NAME="NOVA STORE"
# Brand sementara. Ganti setelah identitas bisnis final (dokumen desain §20.1).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=id-ID
NEXT_PUBLIC_DEFAULT_CURRENCY=IDR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Jakarta

# --- Data layer ---
# pglite  = Postgres tertanam untuk local dev (tanpa kredensial, data di .data/pglite). BUKAN untuk produksi.
# postgres= PostgreSQL/Supabase-managed. Wajib menyediakan DATABASE_URL.
DATA_DRIVER=pglite
PGLITE_DIR=.data/pglite
# Supabase/Postgres. Contoh: postgresql://user:pass@host:5432/postgres?sslmode=require
DATABASE_URL=
# Jumlah koneksi maksimum saat driver postgres.
DATABASE_POOL_MAX=10

# --- Auth & sesi (wajib diganti di staging/production) ---
# Minimal 32 byte acak: `openssl rand -base64 48`. Aplikasi menolak boot di NODE_ENV=production jika kosong.
AUTH_SECRET=
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=4
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_LOCKOUT_MINUTES=15
# Wajib MFA untuk staf/admin (Blueprint §3.1, §13.1).
REQUIRE_MFA_FOR_STAFF=true

# --- Domain aturan bisnis ---
OPERATOR_TIMEZONE=Asia/Jakarta
# Ambang persetujuan berjenjang (maker-checker) untuk refund (Blueprint §9, §8).
REFUND_AUTO_APPROVE_LIMIT=500000
ORDER_PAYMENT_TIMEOUT_MINUTES=60
STOCK_RESERVATION_TTL_MINUTES=30
RETURN_WINDOW_DAYS=14
LOW_STOCK_DEFAULT_THRESHOLD=5

# --- Payment adapter (mock = simulasi lokal, TANPA transaksi nyata) ---
PAYMENT_PROVIDER=mock
# Secret HMAC untuk memverifikasi signature webhook mock. Jangan pakai nilai ini di produksi.
MOCK_WEBHOOK_SECRET=
# Setelah kontrak provider teken, isi nilai berikut (jangan commit):
MIDTRANS_BASE_URL=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_WEBHOOK_TOKEN=
XENDIT_BASE_URL=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Shipping adapter ---
SHIPPING_PROVIDER=mock
BITESHIP_BASE_URL=
BITESHIP_API_KEY=

# --- Notifikasi (email transaksi) ---
# sink=log berarti dicatat di tabel notification_outbox + log server, TIDAK mengirim email nyata.
NOTIFY_SINK=log
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM_ADDRESS=

# --- Observability (opsional) ---
SENTRY_DSN=
LOG_LEVEL=info
