{
  "name": "ndre-gstore",
  "version": "0.1.0",
  "private": true,
  "description": "ndre.gstore (brand sementara: NOVA STORE) - storefront B2C + admin center. Acuan: Blueprint E-Commerce Enterprise v1.0 + Spesifikasi UI/UX v1.0.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:components": "vitest run --project components",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset-dev-db.mjs",
    "jobs:outbox": "node scripts/process-outbox.mjs",
    "audit:secrets": "node scripts/secret-scan.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "clsx": "2.1.1",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
